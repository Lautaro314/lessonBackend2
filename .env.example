# --- Obligatorias: la app no arranca si falta alguna ---
PORT=8080
NODE_ENV=development
MONGODB_URI=mongodb://user:password@localhost:27017/shipnow?authSource=admin
SECRET=replace_with_random_session_secret
JWT_SECRET=replace_with_random_jwt_secret

# --- URLs de servicios externos (Google OAuth) ---
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
GOOGLE_CALLBACK=http://localhost:8080/api/v1/auth/google/callback

# --- Opcionales ---
# Nivel de logs: fatal | error | warning | info | http | debug
# Por defecto: info en production, debug en el resto
LOG_LEVEL=debug

# URL pública usada en Swagger. Por defecto: http://localhost:PORT
# PUBLIC_URL=https://api.tudominio.com

# Raíz de archivos subidos. Por defecto: carpeta temporal del sistema
# En producción usar un volumen montado, nunca una ruta dentro del repo
# UPLOADS_DIR=/var/lib/shipnow/uploads
