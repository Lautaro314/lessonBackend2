# Entorno de TESTING (separado del desarrollo)
# No contiene secretos reales: es seguro versionarlo.
PORT=8080
NODE_ENV=test
# URI de ejemplo. Los tests levantan una base en memoria (mongodb-memory-server)
# y se conectan directamente a ella, por lo que esta URI no apunta a datos reales.
MONGODB_URI=mongodb://127.0.0.1:27017/shipnow_test
SECRET=test_secret
JWT_SECRET=test_jwt_secret
GOOGLE_CLIENT_ID=test_google_client_id
GOOGLE_CLIENT_SECRET=test_google_client_secret
GOOGLE_CALLBACK=http://localhost:8080/api/v1/auth/google/callback
